# Copy to .env.local (gitignored) and adjust as needed.

# Base URL of the FastAPI backend's API (see ../backend and ../openapi.yaml).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Set to "true" to run the whole app against the in-memory mock instead of
# the real backend (useful offline, or when working on the UI in isolation).
VITE_USE_MOCK_BACKEND=false
