# Copy to .env and adjust as needed. Any SQLAlchemy-supported URL works.
#
# SQLite (default, file-based, no setup required):
DATABASE_URL=sqlite:///./waitlist.db
#
# Postgres (once `psycopg[binary]` or another Postgres driver is installed):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/waitlist
